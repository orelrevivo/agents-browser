{
  "name": "@groubot/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/renderer/index.html",
  "description": "Groubot desktop application",
  "author": "Groubot contributors",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate-agent-assets.mjs && vite build --config vite.renderer.config.ts && node scripts/native-cef.mjs build",
    "native:build": "node scripts/native-cef.mjs build",
    "native:start": "node scripts/native-cef.mjs start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@groubot/browser": "workspace:*",
    "@groubot/ai": "workspace:*",
    "@groubot/db": "workspace:*",
    "@groubot/ui": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
